# Server-side Vercel settings. Never put these values in public JavaScript.
# Neon pooled runtime URL and direct migration URL. Use separate development data.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
SITE_ORIGIN=http://127.0.0.1:4180
BETTER_AUTH_URL=http://127.0.0.1:4180
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
# Private Blob store credential, injected by the Vercel connection.
BLOB_READ_WRITE_TOKEN=
# Contact uses durable database rate limits and provider idempotency keys.
CONTACT_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
CONTACT_ORIGIN=
